resource "aws_s3_bucket" "orders" {
  bucket = "shopco-orders"
}

data "aws_iam_policy_document" "assume" {
  statement {
    actions = ["sts:AssumeRole"]
    principals {
      type        = "AWS"
      identifiers = ["arn:aws:iam::000000000000:root"]
    }
  }
}

resource "aws_iam_role" "shop_api" {
  name               = "shop-api"
  assume_role_policy = data.aws_iam_policy_document.assume.json
}

resource "aws_iam_policy" "shop_api" {
  name   = "shop-api-s3"
  policy = data.aws_iam_policy_document.shop_api.json
}

resource "aws_iam_role_policy_attachment" "shop_api" {
  role       = aws_iam_role.shop_api.name
  policy_arn = aws_iam_policy.shop_api.arn
}

# INSECURE: submitted by a developer "to make it work"
data "aws_iam_policy_document" "shop_api" {
  statement {
    sid       = "AllS3"
    actions   = ["s3:*"]
    resources = ["*"]
  }
}
