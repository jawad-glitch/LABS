groups:
- name: argocd
  rules:
  - record: argocd:application_sync_failure_rate
    expr: rate(argocd_app_sync_total{phase="Failed"}[5m])
  - record: argocd:application_health_degraded
    expr: count(argocd_app_info{health_status!="Healthy"})
  - alert: ArgoCDSyncFailure
    expr: argocd:application_sync_failure_rate > 0.1
    for: 5m
    labels: {severity: warning}
    annotations: {summary: "ArgoCD sync failure rate is high"}
