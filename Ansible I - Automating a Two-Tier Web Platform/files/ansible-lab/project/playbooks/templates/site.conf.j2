# {{ ansible_managed }}
server {
    listen {{ nginx_listen_port }} default_server;
    server_name {{ inventory_hostname }};
    root {{ web_root }};
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location /health {
        access_log off;
        default_type text/plain;
        return 200 "ok {{ inventory_hostname }}";
    }
}
