            "json": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Sid\": \"ListOrdersPrefix\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"s3:ListBucket\",\n      \"Resource\": \"arn:aws:s3:::shopco-orders\",\n      \"Condition\": {\n        \"StringLike\": {\n          \"s3:prefix\": \"orders/*\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"ReadWriteOrders\",\n      \"Effect\": \"Allow\",\n      \"Action\": [\n        \"s3:PutObject\",\n        \"s3:GetObject\"\n      ],\n      \"Resource\": \"arn:aws:s3:::shopco-orders/orders/*\"\n    }\n  ]\n}",
