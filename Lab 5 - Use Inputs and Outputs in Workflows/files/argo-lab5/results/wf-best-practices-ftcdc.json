                    ],
                    "parameters": [
                        {
                            "globalName": "processing-summary",
                            "name": "processing-summary",
                            "valueFrom": {
                                "parameter": "{{steps.process.outputs.parameters.summary}}"
                            }
                        }
                    ]
                },
                "steps": [
                    [
                        {
                            "arguments": {
                                "parameters": [
                                    {
                                        "name": "data",
                                        "value": "{{inputs.parameters.input-data}}"
