{
 "overwrite": true,
 "dashboard": {
  "uid": "system-monitoring",
  "title": "System Monitoring Dashboard",
  "description": "CPU and Memory monitoring for system performance",
  "tags": [
   "monitoring",
   "system",
   "prometheus"
  ],
  "refresh": "5s",
  "time": {
   "from": "now-15m",
   "to": "now"
  },
  "schemaVersion": 39,
  "panels": [
   {
    "id": 1,
    "type": "gauge",
    "title": "Overall CPU Usage",
    "gridPos": {
     "x": 0,
     "y": 0,
     "w": 6,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "100 - (avg(irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "percent",
      "min": 0,
      "max": 100,
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "yellow",
         "value": 70
        },
        {
         "color": "red",
         "value": 85
        }
       ]
      }
     },
     "overrides": []
    }
   },
   {
    "id": 2,
    "type": "stat",
    "title": "Memory Usage Percentage",
    "gridPos": {
     "x": 6,
     "y": 0,
     "w": 6,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "((node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes) * 100"
     }
    ],
    "options": {
     "colorMode": "value",
     "graphMode": "area"
    },
    "fieldConfig": {
     "defaults": {
      "unit": "percent"
     },
     "overrides": []
    }
   },
   {
    "id": 3,
    "type": "gauge",
    "title": "Disk Usage",
    "gridPos": {
     "x": 12,
     "y": 0,
     "w": 6,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "100 - ((node_filesystem_avail_bytes{mountpoint=\"/\",fstype!=\"rootfs\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!=\"rootfs\"}) * 100)"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "percent",
      "min": 0,
      "max": 100,
      "thresholds": {
       "mode": "absolute",
       "steps": [
        {
         "color": "green",
         "value": null
        },
        {
         "color": "yellow",
         "value": 70
        },
        {
         "color": "red",
         "value": 90
        }
       ]
      }
     },
     "overrides": []
    }
   },
   {
    "id": 4,
    "type": "timeseries",
    "title": "CPU Usage by Core",
    "gridPos": {
     "x": 0,
     "y": 8,
     "w": 24,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "100 - (avg by (cpu) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
      "legendFormat": "{{cpu}}"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "percent",
      "max": 100
     },
     "overrides": []
    }
   },
   {
    "id": 5,
    "type": "timeseries",
    "title": "Memory Usage",
    "gridPos": {
     "x": 0,
     "y": 16,
     "w": 24,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / 1024 / 1024 / 1024",
      "legendFormat": "Used Memory (GB)"
     },
     {
      "refId": "B",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "node_memory_MemTotal_bytes / 1024 / 1024 / 1024",
      "legendFormat": "Total Memory (GB)"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "decgbytes",
      "custom": {
       "fillOpacity": 10
      }
     },
     "overrides": []
    }
   },
   {
    "id": 6,
    "type": "timeseries",
    "title": "Network Traffic",
    "gridPos": {
     "x": 0,
     "y": 24,
     "w": 24,
     "h": 8
    },
    "datasource": {
     "type": "prometheus",
     "uid": "prom"
    },
    "targets": [
     {
      "refId": "A",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "irate(node_network_receive_bytes_total{device!=\"lo\"}[5m]) * 8",
      "legendFormat": "{{device}} - Received"
     },
     {
      "refId": "B",
      "datasource": {
       "type": "prometheus",
       "uid": "prom"
      },
      "expr": "irate(node_network_transmit_bytes_total{device!=\"lo\"}[5m]) * 8",
      "legendFormat": "{{device}} - Transmitted"
     }
    ],
    "fieldConfig": {
     "defaults": {
      "unit": "bps"
     },
     "overrides": []
    }
   }
  ]
 }
}
