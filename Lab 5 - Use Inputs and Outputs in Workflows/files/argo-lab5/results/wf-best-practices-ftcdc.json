                                        "name": "format",
                                        "value": "{{inputs.parameters.output-format}}"
                                    }
                                ]
                            },
                            "name": "validate",
                            "template": "input-validator"
                        }
                    ],
                    [
                        {
                            "arguments": {
                                "parameters": [
                                    {
                                        "name": "validated-data",
                                        "value": "{{steps.validate.outputs.parameters.clean-data}}"
                                    },
                                    {
                                        "name": "format",
                                        "value": "{{inputs.parameters.output-format}}"
                                    }
                                ]
                            },
                            "name": "process",
                            "template": "data-processor",
                            "when": "'{{steps.validate.outputs.parameters.is-valid}}' == 'true'"
                        }
                    ]
                ]
            },
            {
                "container": {
                    "args": [
                        "echo \"Validating input data and format...\"\nif echo '{{inputs.parameters.data}}' | jq . \u003e /dev/null 2\u003e\u00261; then\n  echo \"JSON validation: PASSED\"; JSON_VALID=true\nelse\n  echo \"JSON validation: FAILED\"; JSON_VALID=false\nfi\ncase \"{{inputs.parameters.format}}\" in\n  \"json\"|\"yaml\"|\"xml\") echo \"Format validation: PASSED\"; FORMAT_VALID=true ;;\n  *) echo \"Format validation: FAILED\"; FORMAT_VALID=false ;;\nesac\nif [ \"$JSON_VALID\" = true ] \u0026\u0026 [ \"$FORMAT_VALID\" = true ]; then\n  echo \"true\" \u003e /tmp/is-valid.txt\n  echo '{{inputs.parameters.data}}' | jq . \u003e /tmp/clean-data.txt\n  echo \"Overall validation: PASSED\"\nelse\n  echo \"false\" \u003e /tmp/is-valid.txt\n  echo \"{}\" \u003e /tmp/clean-data.txt\n  echo \"Overall validation: FAILED\"\nfi\n"
                    ],
                    "command": [
                        "sh",
                        "-c"
                    ],
                    "image": "lab5-tools:1",
                    "name": "",
                    "resources": {}
                },
                "inputs": {
                    "parameters": [
                        {
                            "name": "data"
                        },
                        {
                            "name": "format"
                        }
                    ]
                },
                "metadata": {},
                "name": "input-validator",
                "outputs": {
                    "parameters": [
                        {
                            "name": "is-valid",
                            "valueFrom": {
                                "path": "/tmp/is-valid.txt"
                            }
                        },
                        {
                            "name": "clean-data",
                            "valueFrom": {
                                "path": "/tmp/clean-data.txt"
                            }
                        }
                    ]
                }
            },
            {
                "container": {
                    "args": [
                        "echo \"Processing validated data in {{inputs.parameters.format}} format...\"\nPROCESSED_DATA=$(echo '{{inputs.parameters.validated-data}}' | jq --arg ts \"$(date)\" '. + {\"processed_at\": $ts, \"processor\": \"argo-workflow\", \"status\": \"completed\"}')\ncase \"{{inputs.parameters.format}}\" in\n  \"json\") echo \"$PROCESSED_DATA\" \u003e /tmp/output.json; echo \"Data processed and saved as JSON\" ;;\n  \"yaml\") echo \"$PROCESSED_DATA\" | jq -r 'to_entries[] | \"\\(.key): \\(.value)\"' \u003e /tmp/output.yaml; echo \"Data processed and saved as YAML\" ;;\n  \"xml\")  { echo \"\u003cdata\u003e\"; echo \"$PROCESSED_DATA\" | jq -r 'to_entries[] | \"\u003c\\(.key)\u003e\\(.value)\u003c/\\(.key)\u003e\"'; echo \"\u003c/data\u003e\"; } \u003e /tmp/output.xml; echo \"Data processed and saved as XML\" ;;\nesac\nRECORD_COUNT=$(echo \"$PROCESSED_DATA\" | jq 'keys | length')\necho \"Processed $RECORD_COUNT fields in {{inputs.parameters.format}} format at $(date)\" \u003e /tmp/summary.txt\necho \"Processing completed successfully\"\necho \"Summary: $(cat /tmp/summary.txt)\"\n"
                    ],
                    "command": [
                        "sh",
                        "-c"
                    ],
                    "image": "lab5-tools:1",
                    "name": "",
                    "resources": {}
                },
                "inputs": {
                    "parameters": [
                        {
                            "name": "validated-data"
                        },
                        {
                            "name": "format"
                        }
                    ]
                },
                "metadata": {},
                "name": "data-processor",
                "outputs": {
                    "artifacts": [
                        {
                            "name": "processed-data",
                            "path": "/tmp/output.{{inputs.parameters.format}}"
                        }
                    ],
                    "parameters": [
                        {
                            "name": "summary",
                            "valueFrom": {
                                "path": "/tmp/summary.txt"
                            }
                        }
                    ]
                }
            }
        ]
